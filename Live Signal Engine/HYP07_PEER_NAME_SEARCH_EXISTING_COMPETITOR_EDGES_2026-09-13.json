  "hypothesis_id": "HYP-07",
  "rule": {
    "rule_id": "HYP04-PEER-NAME-SEARCH-RULE-v1",
    "question": "Which registrant did this counterparty name refer to, when SEC's list of current filers does not contain it?",
    "the_search_only_generates_candidates": "EDGAR's company search is an undocumented prefix match; it returned different results for 'Marconi' and 'Marconi Communications', and its multi-hit XML carries ARRAY(0x...) where the company name should be. Nothing is accepted on its say-so.",
    "acceptance_is_the_lineage_test": "A candidate CIK is accepted only if peer_lineage.assess returns CONTINUOUS against that registrant's own submissions record: filing on the disclosure date, under a matching name. Two accepted registrants is AMBIGUOUS and resolves to nothing.",
    "no_form_type_filter": "type=10-K silently excludes foreign private issuers, who file 20-F. Filtering would make 'no such registrant' indistinguishable from 'files a different form'.",
    "a_resolved_registrant_may_not_trade": "Identifying the registrant and finding it has no current ticker is a RESULT, not a failure: it converts an inference about the method into a documented fact about a named company, which is what a survivorship statement needs.",
    "curates_nothing": "No edge is written and no candidate is promoted. The display gate is untouched."
  },
  "inputs": [
    "HYP05_CANDIDATE_LINKAGE_REAL_ANCHORS_2026-09-12.json",
    "HYP05_CANDIDATE_LINKAGE_LOCKED24ANCHORS_2026-09-12.json",
    "HYP05_CANDIDATE_LINKAGE_HISTORICAL_WALK_2026-09-12.json"
  ],
  "what_this_is": "Which registrant each of 52 already-extracted COMPETITOR-direction counterparty names (merged across three earlier HYP-05 extraction passes) referred to, and whether that registrant still trades. HYP-07's Step 0: a free-to-cheap sanity check on data that already existed before any new discovery work.",
  "what_this_is_not": "Curation. No edge is written to any linkage map, no peer universe is derived here. peer_selection.py's evaluate_peer() is the next, separate step, and needs point-in-time market cap for whatever resolves here first.",
