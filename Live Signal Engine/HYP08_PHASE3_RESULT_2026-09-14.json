 "look_ahead_disclosure": {
  "already_touched": "Every pooled event's anchor-side signed excess_return was already computed (HYP-04/05/06's own anchor-shock pipeline) and already used by HYP-06's and/or HYP-07's own prior, completed, spent Phase 3 runs. HYP-06's peers' MAGNITUDE-based results and HYP-07's peers' delayed-horizon signed results are both already reported and unaffected by this lock.",
  "not_touched": "No same-session peer excess return of any kind, for any pooled peer around any pooled anchor event, has been computed before this lock -- target_same_session.py did not exist before this pass. This lock is written before that computation happens for the first time."
 },
 "sign_convention": "Nothing is flipped, anywhere. A priori, economically motivated predictions, stated before any fit: customer/supplier peers POSITIVE (comovement -- shared revenue chain), competitor peers NEGATIVE (displacement, same convention HYP-07's own target_signed.py already uses). Not significant is a null either way, for either test below.",
 "test_family": {
  "k": 2,
  "test_1_primary": "inference.fit_local_projections(table, horizons=(0,), cluster_key='event_id') -- the plain pooled same-session coefficient, both relationship types combined.",
  "test_2_heterogeneity": "inference.fit_interaction_model(table, cluster_key='event_id') -- the shock:is_competitor interaction coefficient.",
  "complementarity_note": "These are COMPLEMENTARY tests, not redundant ones. If the two relationship types' true effects are opposite-signed and roughly offsetting in the pooled sample, test 1 can come back null while test 2's interaction term is significant -- that is a coherent, reportable joint result, not a contradiction requiring explanation."
 },
